---
import Layout from "../../layouts/Layout.astro";
import "../../styles/global.css";
import posts from "../../data/posts.json";
import { renderMarkdown } from "../../lib/markdown.js";
import { remoteAssetUrl, resolveRelativeLinks, sourceFolderUrl } from "../../lib/content-source.js";
import Icon from "../../components/Icon.astro";
export function getStaticPaths(){return posts.map(post=>({params:{slug:post.slug},props:{post}}));}
const {post}=Astro.props;
const thumbnailUrl=remoteAssetUrl(post.slug,"thumbnail.jpg");
// A post folder holds its content in index.md, or in a README.md when the folder is a standalone example project.
let remoteUrl=remoteAssetUrl(post.slug,"index.md");
let markdown=null;
const failures=[];
for(const file of ["index.md","README.md"]){
  const url=remoteAssetUrl(post.slug,file);
  try{
    const res=await fetch(url);
    if(res.ok){remoteUrl=url;markdown=await res.text();break;}
    failures.push(`failed to fetch ${url} (${res.status})`);
  }catch(err){
    failures.push(`error fetching ${url}: ${err instanceof Error ? err.message : err}`);
  }
}
if(markdown===null){
  console.warn(`[content] ${post.slug}: ${failures.join("; ")}`);
  markdown=`## Content unavailable\n\nThis post's content couldn't be loaded right now. Please check back later.`;
}
// The page header already shows the title, so drop a leading "# Title" that repeats it.
const body=markdown.replace(/^#\s+(.+?)\s*\n+/,(match,heading)=>heading.trim().toLowerCase()===post.title.trim().toLowerCase()?"":match);
const contentHtml=await renderMarkdown(resolveRelativeLinks(body,remoteUrl));
const sortedPosts=[...posts].sort((a,b)=>new Date(b.date).getTime()-new Date(a.date).getTime());
const currentIndex=sortedPosts.findIndex(item=>item.slug===post.slug);
const previousPost=sortedPosts[currentIndex+1];
const nextPost=sortedPosts[currentIndex-1];
const base=import.meta.env.BASE_URL.replace(/\/$/,"");
---
<Layout title={post.title} description={post.description} image={thumbnailUrl}>
<article class="detail">
<header class="detail-header">
<div class="detail-command"><span class="prompt">cat</span> {post.slug}.md</div>
<h1>{post.title}</h1><p class="detail-description">{post.description}</p>
<div class="tags">{post.tags.map(tag=><span class="tag">{tag}</span>)}</div>
</header>
<img class="detail-image" src={thumbnailUrl} alt={post.title} onload="this.style.opacity=1" onerror="this.style.display='none';"/>
<div class="prose" set:html={contentHtml}></div>
<a class="detail-source" href={sourceFolderUrl(post.slug)} target="_blank" rel="noopener noreferrer"><Icon name="github" size={13} /> View source on GitHub</a>
<div class="post-navigation">
{previousPost?<a href={`${base}/posts/${previousPost.slug}/`}><Icon name="arrow-left" size={14} /> {previousPost.title}</a>:<span/>}
{nextPost?<a href={`${base}/posts/${nextPost.slug}/`}>{nextPost.title} <Icon name="arrow-right" size={14} /></a>:<span/>}
</div>
</article></Layout>
