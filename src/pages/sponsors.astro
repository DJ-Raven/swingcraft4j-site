---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import "../styles/global.css";
import { renderMarkdown } from "../lib/markdown.js";
import sponsors from "../data/sponsors.json";
import features from "../data/features.json";
const markdown = await import("../content/sponsors.md?raw").then((m) => m.default);
const contentHtml = await renderMarkdown(markdown);
const { current = [], past = [] } = sponsors;
const statusLabel: Record<string, string> = { pending: "pending", "in-progress": "in progress", done: "done" };
---
<Layout title="~/SwingCraft4j/sponsors" description="Support the open-source Swing libraries and posts on this site.">
<section class="sponsors">
  <div class="detail-command"><span class="prompt">cat</span> sponsors.md</div>
  <h1>Sponsors</h1>
  <div class="prose" set:html={contentHtml}></div>
  <a class="sponsor-cta" href="https://github.com/sponsors/DJ-Raven" target="_blank" rel="noopener noreferrer">
    <Icon name="heart" size={16} />become a sponsor
  </a>

  <div class="section-heading"><h2><span class="prompt">ls</span> sponsors/current</h2></div>
  {current.length ? (
    <div class="sponsor-table-wrap"><table class="sponsor-table">
      <thead><tr><th class="sponsor-avatar"></th><th>GitHub</th></tr></thead>
      <tbody>
        {current.map((s) => (
          <tr>
            <td class="sponsor-avatar"><div class="sponsor-avatar-wrap"><img src={s.avatar} alt={s.name} loading="lazy" /></div></td>
            <td><a href={s.github} target="_blank" rel="noopener noreferrer">{s.name}</a></td>
          </tr>
        ))}
      </tbody>
    </table></div>
  ) : (
    <p class="sponsor-empty">No current sponsors yet — be the first!</p>
  )}

  <div class="section-heading"><h2><span class="prompt">ls</span> sponsors/past</h2></div>
  {past.length ? (
    <div class="sponsor-table-wrap"><table class="sponsor-table">
      <thead><tr><th class="sponsor-avatar"></th><th>GitHub</th></tr></thead>
      <tbody>
        {past.map((s) => (
          <tr>
            <td class="sponsor-avatar"><div class="sponsor-avatar-wrap"><img src={s.avatar} alt={s.name} loading="lazy" /></div></td>
            <td><a href={s.github} target="_blank" rel="noopener noreferrer">{s.name}</a></td>
          </tr>
        ))}
      </tbody>
    </table></div>
  ) : (
    <p class="sponsor-empty">No past sponsors.</p>
  )}

  <div class="section-heading"><h2><span class="prompt">ls</span> features/roadmap</h2></div>
  <p class="feature-intro">
    Sponsorships go straight back into this project — more time to write posts and build the
    features below. Higher sponsorship levels also let me prioritize a specific feature request
    for the next release.
  </p>
  {features.length ? (
    <div class="sponsor-table-wrap feature-table-wrap"><table class="sponsor-table feature-table">
      <thead><tr><th>Feature</th><th>Description</th><th class="feature-status">Status</th></tr></thead>
      <tbody>
        {features.map((f) => (
          <tr>
            <td class="feature-name">{f.feature}</td>
            <td class="feature-description">{f.description}</td>
            <td class="feature-status"><div class="feature-status-wrap"><span class={`status-badge status-${f.status}`}>{statusLabel[f.status] ?? f.status}</span></div></td>
          </tr>
        ))}
      </tbody>
    </table></div>
  ) : (
    <p class="sponsor-empty">No planned features yet.</p>
  )}
  <p class="feature-note">More features will be added over time — check back for updates.</p>
</section>
</Layout>
<style>
.sponsors{max-width:820px;margin:0 auto;padding:65px 20px}
.sponsors h1{margin:0 0 18px}
.sponsor-cta{display:inline-flex;align-items:center;gap:7px;margin:28px 0 50px;padding:10px 18px;border:1px solid var(--border);border-radius:6px;color:#db61a2;font-size:13px}
.sponsor-cta:hover{border-color:#db61a2;background:var(--surface)}
.section-heading{margin:0 0 14px}
.section-heading h2{margin:0;font-size:16px;color:var(--heading)}
.section-heading .prompt{margin-right:4px}
.sponsor-table-wrap{margin-bottom:44px;border:1px solid var(--border);border-radius:8px;overflow:hidden}
.sponsor-table{width:100%;table-layout:fixed;border-collapse:collapse;border-spacing:0}
.sponsor-table th,.sponsor-table td{padding:10px 14px;border:1px solid var(--border);vertical-align:middle}
.sponsor-table thead th{border-top:0}
.sponsor-table tbody tr:last-child td{border-bottom:0}
.sponsor-table tr>*:first-child{border-left:0}
.sponsor-table tr>*:last-child{border-right:0}
.sponsor-table th{background:var(--surface);color:var(--heading);text-align:left;font-size:12px;text-transform:uppercase;letter-spacing:.03em}
.sponsor-table tbody tr:hover{background:var(--surface-hover)}
.sponsor-avatar{width:64px}
.sponsor-table td.sponsor-avatar{padding:0}
.sponsor-avatar-wrap{display:flex;align-items:center;justify-content:center;height:100%;padding:10px 14px}
.sponsor-avatar-wrap img{width:36px;height:36px;border-radius:50%;display:block;border:1px solid var(--border);transition:border-color .15s}
.sponsor-table tbody tr:hover .sponsor-avatar-wrap img{border-color:var(--green)}
.sponsor-table a{color:var(--text);font-size:14px;font-weight:600;overflow-wrap:anywhere}
.sponsor-table a:hover{color:var(--green)}
.sponsor-empty{color:var(--muted);font-size:13px;margin-bottom:44px}
.feature-note{margin:16px 0 0;color:var(--muted);font-size:13px;text-align:center}
.feature-intro{color:var(--muted);font-size:14px;line-height:1.8;margin:0 0 20px}
.feature-table th:first-child,.feature-table .feature-name{width:150px}
.feature-name{color:var(--heading);font-weight:600;font-size:14px}
.feature-description{color:var(--muted);font-size:13px;line-height:1.6;overflow-wrap:anywhere}
.feature-status{width:104px}
.feature-table th.feature-status{text-align:center}
.feature-table td.feature-status{padding:0}
.feature-status-wrap{display:flex;align-items:center;justify-content:center;height:100%;padding:10px 14px}
.status-badge{display:inline-flex;align-items:center;gap:4px;padding:2px 8px;border:1px solid transparent;border-radius:20px;font-size:10px;font-weight:600;white-space:nowrap}
.status-badge::before{content:"";width:5px;height:5px;flex-shrink:0;border-radius:50%;background:currentColor}
.status-pending{color:var(--muted);background:color-mix(in srgb,var(--muted) 14%,transparent);border-color:color-mix(in srgb,var(--muted) 30%,transparent)}
.status-in-progress{color:var(--blue);background:color-mix(in srgb,var(--blue) 14%,transparent);border-color:color-mix(in srgb,var(--blue) 30%,transparent)}
.status-done{color:var(--green);background:color-mix(in srgb,var(--green) 14%,transparent);border-color:color-mix(in srgb,var(--green) 30%,transparent)}
@media(max-width:650px){
.sponsors{padding:45px 14px}
.sponsor-avatar{width:48px}
.sponsor-avatar-wrap{padding:8px 10px}
.sponsor-avatar-wrap img{width:30px;height:30px}
.sponsor-table th,.sponsor-table td{padding:8px 10px}
.feature-table-wrap{border:0;border-radius:0}
.feature-table,.feature-table thead,.feature-table tbody{display:block}
.feature-table thead{display:none}
.feature-table tr{display:flex;flex-wrap:wrap;align-items:center;gap:2px 8px;border:1px solid var(--border);border-radius:8px;padding:10px 12px;margin-bottom:8px;background:var(--surface)}
.feature-table tbody tr:last-child{margin-bottom:0}
.feature-table td{display:block;border:0;padding:0;width:auto}
.feature-table .feature-name{order:1;flex:1 1 auto}
.feature-table .feature-status{order:2;flex:0 0 auto;margin-top:0}
.feature-status-wrap{padding:0;justify-content:flex-end}
.feature-table .feature-description{order:3;flex:0 0 100%;padding-top:3px;line-height:1.45}
.status-badge{gap:3px;padding:1px 7px;font-size:9px}
.status-badge::before{width:4px;height:4px}
}
</style>
