---
import posts from "../data/posts.json";
import Icon from "../components/Icon.astro";
const { title = "~/SwingCraft4j", description = "A terminal-style blog for posts on Java, Swing, and the open-source libraries behind SwingCraft4j.", image } = Astro.props;
const searchIndex = posts.map(({slug,title,description,tags})=>({slug,title,description,tags}));
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image || `${base}/images/og-default.jpg`, Astro.site).toString();
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <script is:inline define:vars={{ base }}>
  (function(){
    try{
      var stored=localStorage.getItem("theme");
      if(stored==="light")document.documentElement.setAttribute("data-theme","light");
    }catch(e){}
  })();
  window.thumbnailFallbackSrc=function(){
    var theme=document.documentElement.getAttribute("data-theme")==="light"?"light":"dark";
    return base+"/images/thumbnail-fallback-"+theme+".svg";
  };
  window.applyThumbnailFallback=function(img){
    img.onerror=null;
    img.dataset.thumbFallback="true";
    img.src=thumbnailFallbackSrc();
  };
  </script>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
  <title>{title}</title>

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="SwingCraft4j" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageURL} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageURL} />
</head>
<body>
<header class="terminal-header">
  <div class="container nav">
    <a class="brand" href={`${base}/`}><Icon name="logo" size={20} /><span class="brand-text">~/SwingCraft4j</span></a>
    <div class="nav-right">
      <div class="nav-actions">
        <a class="sponsor-trigger" href={`${base}/sponsors`}><Icon name="heart" size={14} />sponsors</a>
        <button type="button" class="search-trigger" id="search-trigger"><span class="search-trigger-label"><Icon name="search" size={15} />search</span><kbd>Ctrl K</kbd></button>
        <button type="button" class="theme-toggle" id="theme-toggle" aria-label="Toggle color theme" title="Toggle theme"><span class="icon-to-light"><Icon name="sun" size={16} /></span><span class="icon-to-dark"><Icon name="moon" size={16} /></span></button>
      </div>
    </div>
  </div>
</header>
<main><slot /></main>
<footer class="terminal-footer"><div class="container"><nav class="footer-nav"><a href={`${base}/about`}>about</a></nav><span>© 2026 SwingCraft4j</span></div></footer>
<div class="search-overlay" id="search-overlay" hidden>
  <div class="search-overlay-backdrop" id="search-overlay-backdrop"></div>
  <div class="search-modal" role="dialog" aria-modal="true" aria-label="Search posts">
    <div class="search-modal-input"><span>$</span><input id="overlay-search-input" type="search" placeholder="search posts..." autocomplete="off" /><kbd>esc</kbd></div>
    <div class="search-results" id="search-results"></div>
  </div>
</div>
</body>
</html>
<script type="application/json" id="search-index" set:html={JSON.stringify(searchIndex)} is:inline></script>
<script is:inline define:vars={{ base }}>
const posts = JSON.parse(document.getElementById("search-index").textContent);
const themeToggle = document.getElementById("theme-toggle");
themeToggle.addEventListener("click",()=>{
  const isLight = document.documentElement.getAttribute("data-theme")==="light";
  const next = isLight?"dark":"light";
  if(next==="light") document.documentElement.setAttribute("data-theme","light");
  else document.documentElement.removeAttribute("data-theme");
  try{localStorage.setItem("theme",next);}catch(e){}
  document.querySelectorAll("img[data-thumb-fallback]").forEach(img=>{img.src=thumbnailFallbackSrc();});
});
const trigger = document.getElementById("search-trigger");
const overlay = document.getElementById("search-overlay");
const backdrop = document.getElementById("search-overlay-backdrop");
const input = document.getElementById("overlay-search-input");
const results = document.getElementById("search-results");

function escapeHtml(str){
  return str.replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
}
function renderResults(query){
  const q = query.trim().toLowerCase();
  const matches = (q
    ? posts.filter(p=>`${p.title} ${p.description} ${p.tags.join(" ")}`.toLowerCase().includes(q))
    : posts
  ).slice(0,8);
  results.innerHTML = matches.length ? matches.map(p=>`
    <a class="search-result" href="${base}/posts/${p.slug}/">
      <h3>${escapeHtml(p.title)}</h3>
      <p>${escapeHtml(p.description)}</p>
      <div class="tags">${p.tags.map(t=>`<span class="tag">${escapeHtml(t)}</span>`).join("")}</div>
    </a>`).join("") : `<div class="search-empty">no results for "${escapeHtml(q)}"</div>`;
}
function openOverlay(){
  overlay.hidden = false;
  document.body.style.overflow = "hidden";
  input.value = "";
  renderResults("");
  requestAnimationFrame(()=>{overlay.classList.add("open");input.focus();});
}
function closeOverlay(){
  overlay.classList.remove("open");
  document.body.style.overflow = "";
  setTimeout(()=>{overlay.hidden = true;},150);
}
window.openSearchOverlay = openOverlay;
trigger.addEventListener("click",openOverlay);
backdrop.addEventListener("click",closeOverlay);
input.addEventListener("input",()=>renderResults(input.value));
document.addEventListener("keydown",(e)=>{
  if((e.ctrlKey||e.metaKey) && e.key.toLowerCase()==="k"){e.preventDefault();overlay.hidden?openOverlay():closeOverlay();}
  else if(e.key==="Escape" && !overlay.hidden){closeOverlay();}
});
</script>
<style is:global>
:root{--bg:#0d1117;--bg-rgb:13,17,23;--surface:#161b22;--surface-hover:#1c2128;--text:#c9d1d9;--heading:#f0f6fc;--muted:#8b949e;--border:#30363d;--green:#3fb950;--blue:#58a6ff;--purple:#bc8cff;--code-bg:color-mix(in srgb,var(--surface) 60%,var(--bg) 40%);--max:1050px}
html[data-theme="light"]{--bg:#ffffff;--bg-rgb:255,255,255;--surface:#f6f8fa;--surface-hover:#eaeef2;--text:#24292f;--heading:#1b1f24;--muted:#57606a;--border:#d0d7de;--green:#1a7f37;--blue:#0969da;--purple:#8250df;--code-bg:color-mix(in srgb,var(--surface) 60%,var(--bg) 40%)}
.shiki,.shiki span{color:var(--shiki-dark)}
.shiki{background-color:var(--shiki-dark-bg)}
html[data-theme="light"] .shiki,html[data-theme="light"] .shiki span{color:var(--shiki-light)}
html[data-theme="light"] .shiki{background-color:var(--shiki-light-bg)}
.prose .shiki{background-color:var(--code-bg)}
html[data-theme="light"] .prose .shiki{background-color:var(--code-bg)}
*{box-sizing:border-box}html{height:100%;scroll-behavior:smooth;scrollbar-color:var(--border) transparent;scrollbar-width:thin;-webkit-text-size-adjust:100%;text-size-adjust:100%}
::-webkit-scrollbar{width:11px;height:11px}
::-webkit-scrollbar-track{background:transparent}
::-webkit-scrollbar-corner{background:transparent}
::-webkit-scrollbar-thumb{background-color:var(--border);border:3px solid var(--bg);border-radius:7px}
::-webkit-scrollbar-thumb:hover{background-color:var(--green)}
*{scrollbar-color:var(--border) transparent;scrollbar-width:thin}
.prose pre::-webkit-scrollbar-thumb{border-color:var(--shiki-dark-bg)}
html[data-theme="light"] .prose pre::-webkit-scrollbar-thumb{border-color:var(--shiki-light-bg)}
.search-results::-webkit-scrollbar-thumb{border-color:var(--surface)}
.prose pre{scrollbar-color:var(--border) var(--shiki-dark-bg)}
html[data-theme="light"] .prose pre{scrollbar-color:var(--border) var(--shiki-light-bg)}
.search-results{scrollbar-color:var(--border) var(--surface)}body{margin:0;min-height:100%;display:flex;flex-direction:column;overflow-x:hidden;background:var(--bg);color:var(--text);font-family:"JetBrains Mono","Fira Code",Consolas,monospace;line-height:1.7}main{flex:1 0 auto}a{color:inherit;text-decoration:none}.container{width:min(var(--max),calc(100% - 40px));margin:0 auto}.terminal-header{position:sticky;top:0;z-index:10;border-bottom:1px solid var(--border);background:rgba(var(--bg-rgb),.75);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px)}.nav{min-height:68px;display:flex;align-items:center;justify-content:space-between;gap:30px}.nav-right{display:flex;align-items:center;gap:22px}.nav-actions{display:flex;align-items:center;gap:10px}.brand{display:flex;align-items:center;gap:8px;flex-shrink:0;color:var(--green);font-weight:700}nav{display:flex;gap:22px;color:var(--muted);font-size:13px}nav a:hover{color:var(--green)}nav a:before{content:"./";color:var(--border)}.terminal-footer{margin-top:80px;padding:28px 0;border-top:1px solid var(--border);color:var(--muted);font-size:12px}.terminal-footer .container{display:flex;align-items:center;justify-content:space-between}
.search-trigger{width:200px;height:32px;flex-shrink:0;white-space:nowrap;display:flex;align-items:center;justify-content:space-between;gap:8px;padding:0 10px;background:var(--surface);border:1px solid var(--border);border-radius:6px;color:var(--muted);font:inherit;font-size:12px;line-height:1;cursor:pointer}
.search-trigger:hover{border-color:var(--green);color:var(--text)}
.search-trigger-label{display:flex;align-items:center;gap:8px}
.search-trigger kbd{white-space:nowrap;padding:2px 5px;border:1px solid var(--border);border-radius:4px;font-size:10px;color:var(--muted)}
.theme-toggle{flex-shrink:0;display:flex;align-items:center;justify-content:center;width:32px;height:32px;padding:0;background:var(--surface);border:1px solid var(--border);border-radius:6px;color:var(--muted);font-size:15px;line-height:1;cursor:pointer}
.theme-toggle:hover{border-color:var(--green);color:var(--text)}
.sponsor-trigger{display:inline-flex;align-items:center;gap:6px;flex-shrink:0;height:32px;padding:0 12px;background:var(--surface);border:1px solid var(--border);border-radius:6px;color:#db61a2;font-size:12px;white-space:nowrap}
.sponsor-trigger:hover{border-color:#db61a2;background:rgba(219,97,162,.1)}
.footer-nav{display:flex;align-items:center;gap:22px}
.footer-nav a{color:var(--muted)}
.footer-nav a:hover{color:var(--green)}
.icon-to-dark{display:none}
html[data-theme="light"] .icon-to-light{display:none}
html[data-theme="light"] .icon-to-dark{display:inline}
.search-overlay{position:fixed;inset:0;z-index:100;display:flex;align-items:flex-start;justify-content:center;padding:10vh 20px 20px}
.search-overlay-backdrop{position:absolute;inset:0;background:rgba(13,17,23,.7);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);opacity:0;transition:opacity .15s}
.search-overlay.open .search-overlay-backdrop{opacity:1}
.search-modal{position:relative;width:100%;max-width:640px;max-height:70vh;display:flex;flex-direction:column;background:var(--surface);border:1px solid var(--border);border-radius:10px;box-shadow:0 20px 60px rgba(0,0,0,.5);opacity:0;transform:translateY(-8px);transition:opacity .15s,transform .15s}
.search-overlay.open .search-modal{opacity:1;transform:translateY(0)}
.search-modal-input{display:flex;align-items:center;gap:10px;padding:16px;border-bottom:1px solid var(--border)}
.search-modal-input span{color:var(--green)}
.search-modal-input input{flex:1;min-width:0;border:0;outline:0;background:transparent;color:var(--text);font:inherit;font-size:14px}
.search-modal-input input::placeholder{color:var(--muted)}
.search-modal-input kbd{padding:2px 6px;border:1px solid var(--border);border-radius:4px;font-size:10px;color:var(--muted)}
.search-results{overflow-y:auto;padding:8px}
.search-result{display:block;padding:12px;border-radius:7px;transition:background .1s}
.search-result:hover,.search-result:focus-visible{background:var(--surface-hover)}
.search-result h3{margin:0 0 4px;color:var(--heading);font-size:14px}
.search-result h3:before{content:"# ";color:var(--green)}
.search-result p{margin:0 0 6px;color:var(--muted);font-size:12px;line-height:1.5}
.search-empty{padding:30px 12px;text-align:center;color:var(--muted);font-size:13px}
[hidden]{display:none!important}
@media(max-width:650px){.container{width:min(var(--max),calc(100% - 28px))}.nav{gap:10px;padding:14px 0}.nav-right{gap:10px}.nav-actions{gap:6px}nav{gap:10px}.brand-text{display:none}.brand .icon{width:28px;height:28px}.search-trigger{width:130px;height:28px;padding:0 8px}.theme-toggle{width:28px;height:28px}.search-trigger kbd{display:none}.search-overlay{padding:6vh 12px 12px}.sponsor-trigger{height:28px;padding:0 8px}.terminal-footer{font-size:11px}.terminal-footer .container{gap:10px}.footer-nav{gap:12px}}
</style>